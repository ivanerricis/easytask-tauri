{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "easytask-tauri",
  "version": "0.1.0",
  "identifier": "com.ivanerricis.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EasyTask",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 600,
        "fullscreen": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "tauri-plugin-fs": {
      "scope": [
        "$DOCUMENT/**"
      ],
      "allow": [
        "exists",
        "read",
        "read-meta",
        "mkdir"
      ]
    },
    "tauri-plugin-store": {
      "store": [
        "settings"
      ]
    }
  }
}